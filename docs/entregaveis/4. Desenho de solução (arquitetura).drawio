<mxfile host="app.diagrams.net"><diagram id="arq" name="Arquitetura"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Vita — bem-estar financeiro com IA · desenho de solução (estado em 27/09/2026, projeto do evento no Google Cloud)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1360" height="40" as="geometry"/></mxCell><mxCell id="g_canal" value="Canal (cliente)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="230" as="geometry"/></mxCell><mxCell id="g_agente" value="Agente · Cloud Run + ADK 2.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="720" height="420" as="geometry"/></mxCell><mxCell id="g_modelo" value="Modelo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="300" height="230" as="geometry"/></mxCell><mxCell id="g_dados" value="Dados e conhecimento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="720" height="200" as="geometry"/></mxCell><mxCell id="g_obs" value="Observabilidade e experimentação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="310" width="300" height="390" as="geometry"/></mxCell><mxCell id="g_prod" value="Caminho de produção (desenhado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="300" height="390" as="geometry"/></mxCell><mxCell id="push" value="Push proativo na tela bloqueada&lt;br&gt;gatilho: 3 faturas seguidas sem pagamento integral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="260" height="60" as="geometry"/></mxCell><mxCell id="app" value="App Vita (React, Cloud Run) → chat e telas pela API do agente&lt;br&gt;abertura pré-montada pelo pipeline · fatura · visão financeira&lt;br&gt;tratamentos · confirmação com iToken · falar com uma pessoa&lt;br&gt;nenhum número escrito no front, nenhuma chave de modelo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="orq" value="Orquestrador (LlmAgent raiz)&lt;br&gt;roteia, conversa e monta a resposta com ações do catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="300" height="55" as="geometry"/></mxCell><mxCell id="analista" value="Analista&lt;br&gt;situação do cliente&lt;br&gt;(só via tools)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="140" height="65" as="geometry"/></mxCell><mxCell id="educador" value="Educador&lt;br&gt;conceitos&lt;br&gt;(base local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="515" y="260" width="140" height="65" as="geometry"/></mxCell><mxCell id="normas" value="Especialista em normas (AgentTool, modelo próprio)&lt;br&gt;busca no corpus curado; toda resposta cita a fonte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="370" height="55" as="geometry"/></mxCell><mxCell id="pipeline" value="Pipeline proativo (SequentialAgent)&lt;br&gt;diagnóstico por tools → redator com schema {texto, ações}&lt;br&gt;abertura validada e pré-montada na sessão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="670" y="260" width="370" height="65" as="geometry"/></mxCell><mxCell id="guard" value="Guardrails transversais (plugin em todos os agentes, sem LLM)&lt;br&gt;entrada: normalização, desofuscação, PII mascarada, injeção, outro cliente, escopo, identidade, risco à vida&lt;br&gt;tools: id do cliente só da sessão · faixa V nunca chega na tool de crédito&lt;br&gt;saída: número só do payload das tools, termos proibidos, canário, fonte obrigatória, uma regeneração e resposta segura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="680" height="80" as="geometry"/></mxCell><mxCell id="tools" value="Tools determinísticas e motor de decisão (Python tipado, sem LLM)&lt;br&gt;fatura reconstruída por regra · perfil de risco (faixas A/B/C/V) · Índice de Organização Financeira (4 pilares)&lt;br&gt;T01 usar a reserva (CDI do Banco Central, IR) · T02 parcelar (tabela Price, regra de atenção) · ofertas por faixa&lt;br&gt;motor: ordena pelo custo mensal real · confirmação idempotente com iToken · memória só com consentimento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="680" height="120" as="geometry"/></mxCell><mxCell id="gemini" value="Gemini · Vertex AI (us-central1)&lt;br&gt;via conta de serviço, sem chave&lt;br&gt;papéis em modelos diferentes:&lt;br&gt;orquestrador, especialista, redator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="95" width="260" height="90" as="geometry"/></mxCell><mxCell id="juiz" value="LLM como juiz (só tom e clareza)&lt;br&gt;rubrica; nunca decide número&lt;br&gt;usado na avaliação offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="260" height="75" as="geometry"/></mxCell><mxCell id="bq" value="BigQuery (base do evento)&lt;br&gt;extrato sintético de 1.000 clientes&lt;br&gt;+ tabelas do time (vita_sintetico)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="535" width="210" height="70" as="geometry"/></mxCell><mxCell id="snapshot" value="Snapshot na imagem&lt;br&gt;fatura mensal, perfil de risco,&lt;br&gt;bioimpedância, investimentos, parâmetros" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="590" y="535" width="210" height="70" as="geometry"/></mxCell><mxCell id="cdi" value="CDI · SGS do Banco Central&lt;br&gt;parâmetro com origem e data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="535" width="220" height="70" as="geometry"/></mxCell><mxCell id="corpus" value="Corpus de normas do especialista (8 fontes, 24 trechos)&lt;br&gt;Res. CMN 4.549/2017, Lei 14.690/2023, Lei 14.181/2021…&lt;br&gt;trecho com injeção é barrado na indexação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="620" width="330" height="65" as="geometry"/></mxCell><mxCell id="memoria" value="Memória de longo prazo (SQLite), lida pelas tools&lt;br&gt;chaves permitidas, sem valor de transação&lt;br&gt;consentimento explícito · TTL · esqueça tudo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="620" width="330" height="65" as="geometry"/></mxCell><mxCell id="log" value="Cloud Logging (JSON, dos guardrails e do orquestrador)&lt;br&gt;event=guard: camada, categoria, decisão, hash&lt;br&gt;event=turn: latência e chamadas por conversa&lt;br&gt;nunca o texto da conversa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="345" width="260" height="80" as="geometry"/></mxCell><mxCell id="redteam" value="Red team: 131 casos, 13 categorias&lt;br&gt;roda sem modelo · todas as metas&lt;br&gt;0% de falso positivo (48 legítimas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="260" height="70" as="geometry"/></mxCell><mxCell id="aval" value="Avaliação de qualidade: 28 conversas&lt;br&gt;números no payload 13/13 · faixa V 3/3&lt;br&gt;contrafactual (gênero, idade, cidade):&lt;br&gt;decisões idênticas, tom equivalente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="525" width="260" height="80" as="geometry"/></mxCell><mxCell id="ab" value="Experimentação: revisões com tag&lt;br&gt;no Cloud Run, tráfego 10% → 100%&lt;br&gt;métricas do log, guardrails como freio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="260" height="65" as="geometry"/></mxCell><mxCell id="pubsub" value="Pub/Sub + Cloud Scheduler&lt;br&gt;rotina do gatilho e evento de abertura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5FA3;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="260" height="55" as="geometry"/></mxCell><mxCell id="engine" value="Agent Engine&lt;br&gt;sessões e Memory Bank gerenciados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5FA3;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="260" height="55" as="geometry"/></mxCell><mxCell id="rag" value="RAG Engine / Vertex AI Search&lt;br&gt;mesma interface do corpus local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5FA3;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="260" height="55" as="geometry"/></mxCell><mxCell id="bqlive" value="BigQuery ao vivo&lt;br&gt;no lugar do snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5FA3;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="260" height="55" as="geometry"/></mxCell><mxCell id="armor" value="Model Armor (segunda camada)&lt;br&gt;negado no projeto do evento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="260" height="55" as="geometry"/></mxCell><mxCell id="leg1" value="implementado e medido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="200" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="caminho de produção" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5FA3;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="715" width="200" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="negado no evento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="460" y="715" width="200" height="26" as="geometry"/></mxCell><mxCell id="e0" value="toque" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="push" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="app" target="orq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="orq" target="analista"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="orq" target="educador"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="orq" target="normas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="analista" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;" edge="1" parent="1" source="educador" target="tools"><mxGeometry relative=